DISCORD_TOKEN=your_bot_token_here
# Application ID (Developer Portal → General Information). Required for slash command registration.
CLIENT_ID=your_application_client_id
# OAuth client secret (Developer Portal → OAuth2) — required for /admin web panel login
DISCORD_CLIENT_SECRET=your_application_client_secret
# Comma-separated Discord user IDs allowed to open the bot admin panel (default: owner)
BOT_SUPER_ADMIN_IDS=1262056594993315943
ADMIN_SESSION_SECRET=a_long_random_secret
# Full URL to /admin/auth/callback on your Render web service
ADMIN_CALLBACK_URL=
# Public base URL for the bot web service (used by /admin slash command link button)
ADMIN_PUBLIC_URL=https://your-bot.onrender.com
# Download link shown in /scanner guide and license welcome DMs
SCANNER_DOWNLOAD_URL=https://github.com/popesmoke/test/releases/latest
# Optional: register slash commands instantly in one server (use your server ID during setup)
GUILD_ID=

# Storage mode: discord (recommended), postgres, or json
# When DISCORD_SYNC_CHANNEL_ID is set, discord mode is used automatically.
STORAGE_MODE=discord

# Discord txt-file sync channel (bot data — licenses, tickets, config)
DISCORD_SYNC_CHANNEL_ID=1512923742555345116

# PostgreSQL — only needed if STORAGE_MODE=postgres
# Remove or leave empty on Render to avoid ENOTFOUND errors when DB is deleted.
DATABASE_URL=

# Legacy gzip backup channel (only used with postgres mode)
DISCORD_BACKUP_CHANNEL_ID=
BACKUP_INTERVAL_DAYS=29
BACKUP_AUTO_RESTORE=true
BACKUP_ENABLED=true
