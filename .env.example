DISCORD_TOKEN=your_bot_token_here
# Application ID (Developer Portal → General Information). Required for slash command registration.
CLIENT_ID=your_application_client_id
# Optional: register slash commands instantly in one server (use your server ID during setup)
GUILD_ID=

# PostgreSQL (Render: add from your Postgres service → Connect → Internal Database URL)
# Leave unset for local JSON storage in data/
DATABASE_URL=

# Discord database backup (same bot token + channel as the Virello Scanner API backup)
DISCORD_BACKUP_CHANNEL_ID=
BACKUP_INTERVAL_DAYS=29
BACKUP_AUTO_RESTORE=true
BACKUP_ENABLED=true
